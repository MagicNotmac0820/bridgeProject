# 複製成 .env 再修改。.env 不會進版控。
# 模型名稱格式見 LiteLLM 文件: https://docs.litellm.ai/docs/providers

# -----------------
# 模型設定(預設使用本機 Ollama)
# -----------------
# RAG 決策 LLM,名稱要和 `ollama list` 完全一致
RAG_LLM_MODEL="ollama/llama3.1:8b"
# RAG_LLM_MODEL="gemini/gemini-2.5-flash"
# RAG_LLM_MODEL="openai/gpt-4o-mini"

# RAG 嵌入模型。換模型後向量庫要重建,v1 啟動時會檢查並提示
RAG_EMBED_MODEL="ollama/nomic-embed-text"
# RAG_EMBED_MODEL="openai/text-embedding-3-small"

OLLAMA_API_BASE="http://127.0.0.1:11434"

# -----------------
# API 金鑰(使用雲端模型時才需要)
# -----------------
# GEMINI_API_KEY="your_gemini_api_key_here"
# OPENAI_API_KEY="your_openai_api_key_here"
# ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# -----------------
# 系統設定
# -----------------
RAG_TOP_K=5
